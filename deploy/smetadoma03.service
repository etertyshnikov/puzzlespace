[Unit]
Description=Smetadoma03 FastAPI
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/smetadoma03
Environment="PATH=/opt/smetadoma03/.venv/bin"
ExecStart=/opt/smetadoma03/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
