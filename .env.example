# База данных PostgreSQL
DB_URI=postgresql://smetadoma03:STRONG_PASSWORD@localhost:5432/smetadoma03_db

# Миграции: bash scripts/migrate-apply.sh  (alembic upgrade head)

# JWT-секрет (обязательно сменить на случайную строку!)
# Генерация: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-random-secret-64-chars

# Production-режим
APP_PRODUCTION=true

# Опционально
# DB_POOL_SIZE=10
# JWT_EXPIRE_MINUTES=480

